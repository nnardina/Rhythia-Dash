  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialMessage
  messageSprite: {fileID: 1306162383902850008, guid: 78bf6b7ba52cb1f42aee8e3f56fa6843, type: 3}
  messagePosition: {x: 250, y: 300}
  messageSize: {x: 400, y: 400}
  characterDelay: 0.033
  delayBeforeStart: 0
  delayBetweenMessages: 2
  delayBeforeFadeOut: 1
  fadeOutDuration: 1
  customFont: {fileID: 11400000, guid: 5d3d2ba79c98afd479f3225283025d8d, type: 2}
  fontSize: 40
  textColor: {r: 0, g: 0, b: 0, a: 1}
  textPadding: {x: 20, y: 20}
  textOffset: {x: 0, y: 50}
  tutorialTextBlocks:
  - "\u0411\u0420\u041E, \u0422\u0415\u0411\u0415 \u041D\u0410\u0414\u041E \u0422\u0420\u0415\u041D\u0418\u0420\u041E\u0412\u0410\u0422\u042C\u0421\u042F"
  - "\u0412\u0418\u0414\u0418\u0428\u042C \u0422\u0415 \u041B\u0418\u041D\u0418\u0418
    \u0421\u041B\u0415\u0412\u0410?"
  - "\u041F\u041E\u041F\u0420\u041E\u0411\u0423\u0419 \u041D\u0410\u0416\u0410\u0422\u042C
    ASDF"
  - "\u0410 \u0422\u0415\u041F\u0415\u0420\u042C \u041D\u0410\u0416\u041C\u0418 \u041F\u041E\u0414
    \u0411\u0418\u0422, \u041A\u041E\u0413\u0414\u0410 \u0423\u041F\u0410\u0414\u0415\u0422
    \u041D\u041E\u0422\u0410"
  - "\u0423 \u0422\u0415\u0411\u042F \u0421\u041A\u0420\u042B\u0422\u042B\u0419 \u0422\u0410\u041B\u0410\u041D\u0422,
    \u0421\u041A\u0420\u042B\u0412\u0410\u0419 \u0415\u0413\u041E \u0414\u0410\u041B\u042C\u0428\u0415"
  - "\u0414\u041B\u0418\u041D\u041D\u042B\u0415 \u041D\u041E\u0422\u042B \u041D\u0410\u0414\u041E
    \u0417\u0410\u0416\u0418\u041C\u0410\u0422\u042C \u0415\u0421\u041B\u0418 \u0422\u042B
    \u0415\u0429\u0401 \u041D\u0415 \u041F\u041E\u041D\u042F\u041B"
  - "\u0422\u0412\u041E\u042F \u0426\u0415\u041B\u042C -  \u0423\u0411\u0418\u0412\u0410\u0422\u042C"
  - "\u041D\u041E \u0418\u041D\u041E\u0413\u0414\u0410 \u0416\u0415\u0420\u0422\u0412\u0410
    \u0421\u041E\u041F\u0420\u041E\u0422\u0418\u0412\u041B\u042F\u0415\u0422\u0421\u042F..."
  - "\u041D\u0423 \u0412\u0421\u0415, \u0423\u0414\u0410\u0427\u0418, \u042F \u041D\u0410
    \u041C\u0410\u0416\u041E\u0420 \u0411\u0411"
